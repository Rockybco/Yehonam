# Stripe — https://dashboard.stripe.com/apikeys
# Use sk_test_... while testing. Never expose this key in frontend code.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY

# Stripe webhook signing secret — https://dashboard.stripe.com/webhooks
# Required by /api/webhook for raw-body signature verification.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Public site origin used to build Stripe success/cancel URLs.
# No trailing slash. Use the canonical non-www domain.
SITE_URL=https://yehonam.com

# Hostinger SMTP — used by lib/email.js for order confirmation emails.
# SMTP_HOST and SMTP_USER are your Hostinger mail account settings.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Optional. Defaults to true when SMTP_PORT is 465; set false only when your
# Hostinger account requires STARTTLS on another port.
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_HOSTINGER_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_HOSTINGER_SMTP_PASSWORD

# Verified sender address and display name for transactional emails.
EMAIL_FROM=orders@example.com
EMAIL_FROM_NAME=Yehonam Suds

# Note: STRIPE_PUBLISHABLE_KEY is not used. Checkout is created server-side
# and the browser is redirected to Stripe's hosted payment page.
